@page
@model MovieDB.API.Pages.Movies.IndexModel

@{
    ViewData["Title"] = "Movies";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">MovieDB</h1>
        <p class="lead text-secondary">
            Discover movies and explore their details.
        </p>
    </div>

    <div class="row g-4">
        @if (Model.Movies.Count == 0)
        {
            <div class="col-12">
                <div class="alert alert-info text-center">
                    No movies found.
                </div>
            </div>
        }
        else
        {
            @foreach (var movie in Model.Movies)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm movie-card">
                        <div class="card-body d-flex flex-column">
                            <h2 class="card-title h5 fw-bold">
                                @movie.Title
                            </h2>

                            <p class="card-text text-secondary">
                                <strong>Release Year:</strong>
                                @movie.ReleaseYear
                            </p>

                            <a href="/Movies/Details?id=@movie.Id" class="btn btn-primary">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>